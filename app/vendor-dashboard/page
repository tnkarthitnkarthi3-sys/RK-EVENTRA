```tsx
"use client";

import { useEffect, useState } from "react";

type Booking = {
  id: string;
  eventDate: string;
  eventType: string;
  location: string | null;
  totalAmount: number;
  status: string;
};

type Service = {
  id: string;
  name: string;
  description: string | null;
  category: string;
  price: number;
};

export default function VendorDashboardPage() {
  const [bookings, setBookings] = useState<Booking[]>([]);
  const [services, setServices] = useState<Service[]>([]);

  const [loading, setLoading] = useState(true);
  const [servicesLoading, setServicesLoading] = useState(true);

  const [error, setError] = useState("");
  const [serviceError, setServiceError] = useState("");

  const [showServiceForm, setShowServiceForm] = useState(false);
  const [editingServiceId, setEditingServiceId] = useState<string | null>(null);
  const [savingService, setSavingService] = useState(false);

  const [serviceName, setServiceName] = useState("");
  const [serviceCategory, setServiceCategory] = useState("");
  const [serviceDescription, setServiceDescription] = useState("");
  const [servicePrice, setServicePrice] = useState("");

  async function loadBookings() {
    try {
      setLoading(true);
      setError("");

      const meResponse = await fetch("/api/auth/me");
      const meData = await meResponse.json();

      if (!meResponse.ok || !meData.success) {
        throw new Error("Please login first");
      }

      if (meData.user.role !== "VENDOR") {
        throw new Error("Only vendors can access this dashboard");
      }

      const response = await fetch(
        `/api/bookings/vendor?userId=${meData.user.id}`
      );

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Failed to load bookings");
      }

      setBookings(data.bookings);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Something went wrong"
      );
    } finally {
      setLoading(false);
    }
  }

  async function loadServices() {
    try {
      setServicesLoading(true);
      setServiceError("");

      const response = await fetch("/api/services");
      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Failed to load services");
      }

      setServices(data.services);
    } catch (err) {
      setServiceError(
        err instanceof Error ? err.message : "Failed to load services"
      );
    } finally {
      setServicesLoading(false);
    }
  }

  useEffect(() => {
    loadBookings();
    loadServices();
  }, []);

  function openAddService() {
    setEditingServiceId(null);
    setServiceName("");
    setServiceCategory("");
    setServiceDescription("");
    setServicePrice("");
    setServiceError("");
    setShowServiceForm(true);
  }

  function openEditService(service: Service) {
    setEditingServiceId(service.id);
    setServiceName(service.name);
    setServiceCategory(service.category);
    setServiceDescription(service.description || "");
    setServicePrice(String(service.price));
    setServiceError("");
    setShowServiceForm(true);
  }

  function closeServiceForm() {
    setShowServiceForm(false);
    setEditingServiceId(null);
    setServiceName("");
    setServiceCategory("");
    setServiceDescription("");
    setServicePrice("");
    setServiceError("");
  }

  async function saveService(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();

    try {
      setSavingService(true);
      setServiceError("");

      const isEditing = Boolean(editingServiceId);

      const response = await fetch("/api/services", {
        method: isEditing ? "PUT" : "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          ...(isEditing && {
            serviceId: editingServiceId,
          }),
          name: serviceName,
          category: serviceCategory,
          description: serviceDescription,
          price: servicePrice,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(
          data.message ||
            (isEditing
              ? "Failed to update service"
              : "Failed to create service")
        );
      }

      closeServiceForm();
      await loadServices();
    } catch (err) {
      setServiceError(
        err instanceof Error ? err.message : "Failed to save service"
      );
    } finally {
      setSavingService(false);
    }
  }

  async function deleteService(serviceId: string) {
    const confirmed = window.confirm(
      "Are you sure you want to delete this service?"
    );

    if (!confirmed) return;

    try {
      setServiceError("");

      const response = await fetch("/api/services", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          serviceId,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Failed to delete service");
      }

      await loadServices();
    } catch (err) {
      setServiceError(
        err instanceof Error ? err.message : "Failed to delete service"
      );
    }
  }

  async function updateStatus(
    bookingId: string,
    status: "CONFIRMED" | "CANCELLED"
  ) {
    try {
      const response = await fetch("/api/bookings/status", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          bookingId,
          status,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Failed to update booking");
      }

      await loadBookings();
    } catch (err) {
      alert(
        err instanceof Error ? err.message : "Failed to update booking"
      );
    }
  }

  const pendingCount = bookings.filter(
    (booking) => booking.status === "PENDING"
  ).length;

  const confirmedCount = bookings.filter(
    (booking) => booking.status === "CONFIRMED"
  ).length;

  return (
    <main className="min-h-screen bg-slate-950 text-white">
      {/* BACKGROUND */}
      <div className="fixed inset-0 -z-0 overflow-hidden">
        <div className="absolute left-[-120px] top-[-120px] h-96 w-96 rounded-full bg-purple-600/30 blur-3xl" />
        <div className="absolute right-[-100px] top-[15%] h-96 w-96 rounded-full bg-blue-600/25 blur-3xl" />
        <div className="absolute bottom-[-150px] left-[30%] h-96 w-96 rounded-full bg-pink-600/20 blur-3xl" />

        <div className="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_35%)]" />
      </div>

      <div className="relative z-10">
        {/* NAVBAR */}
        <header className="border-b border-white/10 bg-black/20 backdrop-blur-xl">
          <div className="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 md:px-8">
            <div>
              <h1 className="text-2xl font-black tracking-wide">
                RK <span className="text-purple-400">EVENTRA</span>
              </h1>

              <p className="mt-1 text-xs text-slate-400">
                Vendor Control Center
              </p>
            </div>

            <button
              onClick={openAddService}
              className="rounded-xl bg-white px-5 py-3 text-sm font-bold text-slate-900 shadow-lg transition hover:-translate-y-0.5 hover:bg-purple-100"
            >
              + Add Service
            </button>
          </div>
        </header>

        <div className="mx-auto max-w-7xl px-5 py-8 md:px-8 md:py-12">
          {/* HERO */}
          <section className="mb-10">
            <p className="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-purple-300">
              Welcome Vendor
            </p>

            <h2 className="text-4xl font-black tracking-tight md:text-5xl">
              Grow Your Event
              <span className="block bg-gradient-to-r from-purple-300 via-pink-300 to-blue-300 bg-clip-text text-transparent">
                Business With Us.
              </span>
            </h2>

            <p className="mt-4 max-w-2xl text-slate-300">
              Manage your services, receive customer bookings and grow your
              event business from one powerful dashboard.
            </p>
          </section>

          {/* STATS */}
          <section className="grid gap-5 md:grid-cols-3">
            <StatCard
              icon="📋"
              title="Total Bookings"
              value={loading ? "..." : bookings.length}
              description="All customer requests"
            />

            <StatCard
              icon="⏳"
              title="Pending"
              value={loading ? "..." : pendingCount}
              description="Waiting for your action"
              accent="yellow"
            />

            <StatCard
              icon="✓"
              title="Confirmed"
              value={loading ? "..." : confirmedCount}
              description="Successfully confirmed"
              accent="green"
            />
          </section>

          {/* SERVICE FORM */}
          {showServiceForm && (
            <section className="mt-8 rounded-3xl border border-white/10 bg-white/10 p-6 shadow-2xl backdrop-blur-xl md:p-8">
              <div className="flex items-start justify-between gap-4">
                <div>
                  <p className="text-sm font-semibold text-purple-300">
                    SERVICE MANAGEMENT
                  </p>

                  <h2 className="mt-1 text-2xl font-black">
                    {editingServiceId
                      ? "Edit Your Service"
                      : "Create New Service"}
                  </h2>

                  <p className="mt-2 text-sm text-slate-400">
                    Add clear details so customers can understand your
                    offering.
                  </p>
                </div>

                <button
                  onClick={closeServiceForm}
                  className="rounded-xl bg-white/10 px-4 py-2 text-xl text-slate-300 transition hover:bg-white/20"
                >
                  ×
                </button>
              </div>

              <form
                onSubmit={saveService}
                className="mt-7 grid gap-5 md:grid-cols-2"
              >
                <div>
                  <label className="text-sm font-semibold text-slate-200">
                    Service Name
                  </label>

                  <input
                    type="text"
                    value={serviceName}
                    onChange={(e) => setServiceName(e.target.value)}
                    placeholder="Wedding Photography"
                    required
                    className="mt-2 w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-purple-400"
                  />
                </div>

                <div>
                  <label className="text-sm font-semibold text-slate-200">
                    Category
                  </label>

                  <select
                    value={serviceCategory}
                    onChange={(e) => setServiceCategory(e.target.value)}
                    required
                    className="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-purple-400"
                  >
                    <option value="">Select category</option>
                    <option value="DJ & Sound">DJ & Sound</option>
                    <option value="Decoration">Decoration</option>
                    <option value="Photography">Photography</option>
                    <option value="Videography">Videography</option>
                    <option value="Catering">Catering</option>
                    <option value="Stage Setup">Stage Setup</option>
                    <option value="Lighting">Lighting</option>
                    <option value="Generator">Generator</option>
                    <option value="Makeup & Bridal">Makeup & Bridal</option>
                    <option value="Chairs & Tables">Chairs & Tables</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div className="md:col-span-2">
                  <label className="text-sm font-semibold text-slate-200">
                    Description
                  </label>

                  <textarea
                    value={serviceDescription}
                    onChange={(e) =>
                      setServiceDescription(e.target.value)
                    }
                    placeholder="Describe your service..."
                    rows={4}
                    className="mt-2 w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-purple-400"
                  />
                </div>

                <div>
                  <label className="text-sm font-semibold text-slate-200">
                    Price
                  </label>

                  <input
                    type="number"
                    min="1"
                    value={servicePrice}
                    onChange={(e) => setServicePrice(e.target.value)}
                    placeholder="15000"
                    required
                    className="mt-2 w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-purple-400"
                  />
                </div>

                {serviceError && (
                  <div className="rounded-xl border border-red-400/20 bg-red-500/10 p-4 text-red-300 md:col-span-2">
                    {serviceError}
                  </div>
                )}

                <div className="flex gap-3 md:col-span-2">
                  <button
                    type="submit"
                    disabled={savingService}
                    className="rounded-xl bg-white px-6 py-3 font-bold text-slate-900 transition hover:bg-purple-100 disabled:opacity-50"
                  >
                    {savingService
                      ? "Saving..."
                      : editingServiceId
                      ? "Update Service"
                      : "Save Service"}
                  </button>

                  <button
                    type="button"
                    onClick={closeServiceForm}
                    className="rounded-xl border border-white/15 bg-white/5 px-6 py-3 font-semibold text-white hover:bg-white/10"
                  >
                    Cancel
                  </button>
                </div>
              </form>
            </section>
          )}

          {/* SERVICES */}
          <section className="mt-12">
            <div className="mb-5 flex flex-col justify-between gap-3 md:flex-row md:items-end">
              <div>
                <p className="text-sm font-semibold uppercase tracking-wider text-purple-300">
                  Your Business
                </p>

                <h2 className="mt-1 text-3xl font-black">
                  My Services
                </h2>

                <p className="mt-2 text-slate-400">
                  Services currently offered by your business.
                </p>
              </div>

              <span className="w-fit rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-bold text-slate-200 backdrop-blur">
                {services.length} Services
              </span>
            </div>

            {servicesLoading && (
              <div className="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-slate-300">
                Loading services...
              </div>
            )}

            {serviceError && !showServiceForm && (
              <div className="rounded-2xl border border-red-400/20 bg-red-500/10 p-5 text-red-300">
                {serviceError}
              </div>
            )}

            {!servicesLoading &&
              !serviceError &&
              services.length === 0 && (
                <div className="rounded-3xl border border-dashed border-white/15 bg-white/5 p-12 text-center backdrop-blur">
                  <div className="text-5xl">🛠️</div>

                  <h3 className="mt-5 text-xl font-bold">
                    No services yet
                  </h3>

                  <p className="mt-2 text-slate-400">
                    Add your first event service to start receiving
                    bookings.
                  </p>

                  <button
                    onClick={openAddService}
                    className="mt-6 rounded-xl bg-white px-6 py-3 font-bold text-slate-900"
                  >
                    + Add First Service
                  </button>
                </div>
              )}

            <div className="grid gap-5 md:grid-cols-2">
              {services.map((service) => (
                <div
                  key={service.id}
                  className="group rounded-3xl border border-white/10 bg-white/10 p-6 shadow-xl backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-purple-400/30 hover:bg-white/[0.13]"
                >
                  <div className="flex items-start justify-between gap-4">
                    <div>
                      <div className="mb-3 text-3xl">
                        {getCategoryIcon(service.category)}
                      </div>

                      <h3 className="text-xl font-black">
                        {service.name}
                      </h3>

                      <span className="mt-3 inline-block rounded-full bg-purple-500/15 px-3 py-1 text-xs font-bold text-purple-300">
                        {service.category}
                      </span>
                    </div>

                    <p className="whitespace-nowrap text-xl font-black text-white">
                      ₹{service.price.toLocaleString("en-IN")}
                    </p>
                  </div>

                  <p className="mt-5 min-h-12 text-sm leading-6 text-slate-400">
                    {service.description ||
                      "No description provided."}
                  </p>

                  <div className="mt-6 flex gap-3 border-t border-white/10 pt-5">
                    <button
                      onClick={() => openEditService(service)}
                      className="flex-1 rounded-xl bg-blue-500/15 px-4 py-2.5 text-sm font-bold text-blue-300 transition hover:bg-blue-500/25"
                    >
                      Edit
                    </button>

                    <button
                      onClick={() => deleteService(service.id)}
                      className="flex-1 rounded-xl bg-red-500/15 px-4 py-2.5 text-sm font-bold text-red-300 transition hover:bg-red-500/25"
                    >
                      Delete
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* BOOKINGS */}
          <section className="mt-14">
            <div className="mb-5">
              <p className="text-sm font-semibold uppercase tracking-wider text-blue-300">
                Customer Requests
              </p>

              <h2 className="mt-1 text-3xl font-black">
                Customer Bookings
              </h2>

              <p className="mt-2 text-slate-400">
                Review and manage incoming event bookings.
              </p>
            </div>

            {loading && (
              <div className="rounded-2xl border border-white/10 bg-white/5 p-8 text-center text-slate-300">
                Loading bookings...
              </div>
            )}

            {error && (
              <div className="rounded-2xl border border-red-400/20 bg-red-500/10 p-6 text-red-300">
                {error}
              </div>
            )}

            {!loading && !error && bookings.length === 0 && (
              <div className="rounded-3xl border border-dashed border-white/15 bg-white/5 p-12 text-center">
                <div className="text-5xl">📅</div>

                <h3 className="mt-5 text-xl font-bold">
                  No bookings yet
                </h3>

                <p className="mt-2 text-slate-400">
                  Customer booking requests will appear here.
                </p>
              </div>
            )}

            <div className="space-y-5">
              {bookings.map((booking) => (
                <div
                  key={booking.id}
                  className="rounded-3xl border border-white/10 bg-white/10 p-6 shadow-xl backdrop-blur-xl"
                >
                  <div className="flex flex-col justify-between gap-6 md:flex-row">
                    <div>
                      <span className="rounded-full bg-blue-500/15 px-3 py-1 text-xs font-bold text-blue-300">
                        EVENT BOOKING
                      </span>

                      <h3 className="mt-4 text-2xl font-black">
                        {booking.eventType}
                      </h3>

                      <div className="mt-4 space-y-2 text-sm text-slate-400">
                        <p>
                          📅{" "}
                          {new Date(
                            booking.eventDate
                          ).toLocaleDateString("en-IN")}
                        </p>

                        <p>
                          📍 {booking.location || "Not specified"}
                        </p>
                      </div>
                    </div>

                    <div className="text-left md:text-right">
                      <p className="text-2xl font-black">
                        ₹
                        {booking.totalAmount.toLocaleString(
                          "en-IN"
                        )}
                      </p>

                      <span
                        className={`mt-3 inline-block rounded-full px-4 py-2 text-xs font-black ${
                          booking.status === "CONFIRMED"
                            ? "bg-green-500/15 text-green-300"
                            : booking.status === "CANCELLED"
                            ? "bg-red-500/15 text-red-300"
                            : "bg-yellow-500/15 text-yellow-300"
                        }`}
                      >
                        {booking.status}
                      </span>
                    </div>
                  </div>

                  {booking.status === "PENDING" && (
                    <div className="mt-6 flex flex-wrap gap-3 border-t border-white/10 pt-5">
                      <button
                        onClick={() =>
                          updateStatus(
                            booking.id,
                            "CONFIRMED"
                          )
                        }
                        className="rounded-xl bg-green-500/15 px-6 py-3 text-sm font-bold text-green-300 transition hover:bg-green-500/25"
                      >
                        ✓ Confirm Booking
                      </button>

                      <button
                        onClick={() =>
                          updateStatus(
                            booking.id,
                            "CANCELLED"
                          )
                        }
                        className="rounded-xl bg-red-500/15 px-6 py-3 text-sm font-bold text-red-300 transition hover:bg-red-500/25"
                      >
                        ✕ Cancel Booking
                      </button>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>

          {/* FOOTER */}
          <footer className="mt-16 border-t border-white/10 py-8 text-center">
            <p className="font-bold">
              RK <span className="text-purple-400">EVENTRA</span>
            </p>

            <p className="mt-2 text-sm text-slate-500">
              Event Services Marketplace • 2026
            </p>
          </footer>
        </div>
      </div>
    </main>
  );
}

function getCategoryIcon(category: string) {
  const icons: Record<string, string> = {
    "DJ & Sound": "🎧",
    Decoration: "🎀",
    Photography: "📸",
    Videography: "🎥",
    Catering: "🍽️",
    "Stage Setup": "🎪",
    Lighting: "💡",
    Generator: "⚡",
    "Makeup & Bridal": "💄",
    "Chairs & Tables": "🪑",
  };

  return icons[category] || "🎉";
}

function StatCard({
  icon,
  title,
  value,
  description,
  accent = "purple",
}: {
  icon: string;
  title: string;
  value: number | string;
  description: string;
  accent?: "purple" | "yellow" | "green";
}) {
  const accentClasses = {
    purple: "from-purple-500/20 to-blue-500/10",
    yellow: "from-yellow-500/20 to-orange-500/10",
    green: "from-green-500/20 to-emerald-500/10",
  };

  return (
    <div
      className={`rounded-3xl border border-white/10 bg-gradient-to-br ${accentClasses[accent]} p-6 shadow-xl backdrop-blur-xl transition hover:-translate-y-1`}
    >
      <div className="flex items-start justify-between">
        <div>
          <p className="text-sm font-semibold text-slate-400">
            {title}
          </p>

          <p className="mt-3 text-4xl font-black">
            {value}
          </p>

          <p className="mt-2 text-xs text-slate-500">
            {description}
          </p>
        </div>

        <div className="rounded-2xl bg-white/10 p-4 text-2xl">
          {icon}
        </div>
      </div>
    </div>
  );
}
